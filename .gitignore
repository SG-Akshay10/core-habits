# macOS
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Node / Next.js (also see app/.gitignore for app-specific rules)
node_modules/
.next/
out/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files — never commit secrets. .env.example files are intentionally allowed.
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
!.env.example

# Vercel
.vercel

# Neon CLI local state
.neon
.prd