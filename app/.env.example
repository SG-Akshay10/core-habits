# Copy this file to .env (for local dev) and fill in real values.
# Never commit the actual .env file — it's gitignored.

# --- Database ---
# Use a Neon project's POOLED connection string for runtime queries.
# (Dashboard: Neon project -> Connect -> "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"

# Use the DIRECT (unpooled) connection string for Prisma migrations.
# (Dashboard: Neon project -> Connect -> "Direct connection")
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generate a random secret: `npx auth secret` (run inside app/)
AUTH_SECRET=""

# --- Google OAuth client ---
# From Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI (for this env): <BASE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Web Push (reminders) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# --- Cron ---
# Shared secret required by /api/cron/reminders (sent as the
# `x-cron-secret` header or `Authorization: Bearer <secret>`). Vercel Cron
# requests already include an auth header Vercel verifies for you, but this
# extra secret protects the route on any other host/scheduler.
CRON_SECRET=""

